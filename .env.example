# Vidiaura — variables de entorno
#
# Copia este archivo a `.env.local` y rellena los valores reales.
# `.env.local` está en .gitignore: nunca lo commitees ni pegues sus valores en issues.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Supabase
#
# Con MOCK_SUPABASE=true (o sin NEXT_PUBLIC_SUPABASE_URL) la app usa un usuario
# mock y el adaptador de persistencia en memoria. Útil para desarrollo offline.
# ---------------------------------------------------------------------------
MOCK_SUPABASE=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. Bypassa RLS: úsalo únicamente tras autorizar por dueño.
SUPABASE_SERVICE_ROLE_KEY=

# Buckets privados; el primer segmento de cada ruta debe ser auth.uid().
SUPABASE_STORAGE_BUCKET_ASSETS=project-assets
SUPABASE_STORAGE_BUCKET_RENDERS=rendered-videos

# ---------------------------------------------------------------------------
# Gemini (solo servidor)
#
# Sin GEMINI_API_KEY los endpoints responden 200 con fallback determinista.
# Verifica los IDs con ListModels antes de fijarlos: no los asumas.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Stripe (solo servidor, salvo la publishable key)
#
# El billing por suscripción no forma parte del alcance actual; se dejan
# documentadas para no romper despliegues que ya las leen.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
