# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (set MOCK_SUPABASE=true to run fully offline with the in-memory adapter)
MOCK_SUPABASE=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_ASSETS=project-assets
SUPABASE_STORAGE_BUCKET_RENDERS=rendered-videos

# Gemini (server only). Without a key the app uses deterministic fallbacks.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_VISION_MODEL=gemini-3.5-flash

# Stripe (not used yet)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
